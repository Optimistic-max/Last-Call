# Copy this file to .env and fill in the values. NEVER commit .env.
# This file lists names only. Every value stays empty here (docs/SECURITY.md).

# PayPal sandbox app (Developer Dashboard > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Must be the sandbox URL from docs/PAYPAL_INTEGRATION.md section 1.
# The app refuses to start with any other value.
PAYPAL_BASE_URL=

# Neon Postgres. Use a separate Neon branch for tests.
DATABASE_URL=
TEST_DATABASE_URL=

# AI model that reads one friend's own-words pledge (D31). The provider is set here, not in code (D75):
# Azure OpenAI or Groq. Leave AI_BASE_URL empty to use Groq's address (D15); for Groq, AI_MODEL is openai/gpt-oss-20b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Flask session signing key: any long random string
FLASK_SECRET_KEY=

# Public address of the app, used to build pledge links (the local Flask address, or the Render URL)
APP_BASE_URL=
